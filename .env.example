# LBrain example environment — copy to .env and fill in. NEVER commit a real .env.
# (.env is gitignored; only this .example file is tracked.)

# Embedding provider key (set the one matching embedding_provider in config.toml).
OPENAI_API_KEY=sk-your-openai-key-here
# GEMINI_API_KEY=your-gemini-key-here

# Optional: agent container image + key for the docker-compose.kite.yml example.
# AGENT_IMAGE=your-agent-image:latest
# ANTHROPIC_API_KEY=your-anthropic-key-here

# --- lbrain-proxy only (contrib/lbrain-proxy) ---
# Comma-separated user tokens you issue. REQUIRED — the proxy fails closed (503)
# with none set, so it never becomes an open relay for your real key.
# LBRAIN_PROXY_TOKENS=token-for-alice,token-for-bob
# LBRAIN_PROXY_RATE_PER_MIN=120
